{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://bcrs.gov.bc.ca/.well_known/schemas/contactPoint",
  "required": [
    "email"
  ],
  "type": "object",
  "title": "Business Contact Point Schema",
      "properties": {
          "email": {
              "type": "string",
              "format": "email",
              "pattern": "^(([^<>()[\\]\\\\.,;:\\s@\"]+(\\.[^<>()[\\]\\\\.,;:\\s@\"]+)*)|(\".+\"))@((\\[[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}])|(([a-zA-Z\\-0-9]+\\.)+[a-zA-Z]{2,}))$"
          },
          "phone": {
              "type": "string",
              "format": "phone"
          },
          "extension": {
              "type": "number"
          }
      }
}
