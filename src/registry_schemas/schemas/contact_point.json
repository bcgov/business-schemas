{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://bcrs.gov.bc.ca/.well_known/schemas/contactPoint",
  "required": [
    "email"
  ],
  "type": "object",
  "title": "Business Contact Point Schema",
      "properties": {
          "email": {
              "type": "string",
              "format": "email",
              "pattern": "^(?=[^@]{1,64}@)[^<>()[\\]\\\\.,;:\\s@\"\\u0080-\\uFFFF]+(\\.[^<>()[\\]\\\\.,;:\\s@\"\\u0080-\\uFFFF]+)*@(\\[(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9][0-9]|[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9][0-9]|[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9][0-9]|[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9][0-9]|[0-9])\\]|([a-zA-Z0-9]([a-zA-Z0-9\\-]*[a-zA-Z0-9])?\\.)+[a-zA-Z]{2,})(?!\\n)$"
          },
          "phone": {
              "type": "string",
              "format": "phone"
          },
          "extension": {
              "type": "number"
          }
      }
}
