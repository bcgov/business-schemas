{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://bcrs.gov.bc.ca/.well_known/schemas/review_imported_data",
  "title": "Review Imported Data Filing",
  "definitions": {},
  "required": [
    "reviewImportedData"
  ],
  "type": "object",
  "properties": {
    "reviewImportedData": {
      "type": "object",
      "properties": {
        "offices": {
          "type": "object",
          "properties": {
            "registeredOffice": {
              "$ref": "https://bcrs.gov.bc.ca/.well_known/schemas/office"
            },
            "recordsOffice": {
              "$ref": "https://bcrs.gov.bc.ca/.well_known/schemas/office"
            }
          },
          "anyOf": [
            {
              "required": ["registeredOffice"]
            },
            {
              "required": ["recordsOffice"]
            }
          ]
        },
        "relationships": {
          "type": "array",
          "minItems": 1,
          "items": {
            "allOf": [
              {
                "$ref": "https://bcrs.gov.bc.ca/.well_known/schemas/relationship"
              },
              {
                "properties": {
                  "entity": {
                    "required": ["identifier"]
                  },
                  "roles": {
                    "items": {
                      "properties": {
                        "roleType": {
                          "const": "Director"
                        }
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "anyOf": [
        {
          "required": ["offices"]
        },
        {
          "required": ["relationships"]
        }
      ]
    }
  }
}
