{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://bcrs.gov.bc.ca/.well_known/schemas/change_of_directors",
    "required": [
        "changeOfDirectors"
    ],
    "type": "object",
    "title": "Change of Directors Filing",
    "definitions": {
        "actions": {
            "type": "object",
            "properties": {
                "actions": {
                    "type": "array",
                    "title": "List of actions taken on a director",
                    "items": {
                        "type": "string",
                        "enum": [
                            "appointed",
                            "ceased",
                            "nameChanged",
                            "addressChanged"
                        ]
                    }
                }
            },
            "required": [
                "actions"
            ]
        },
        "relationshipActions": {
            "type": "object",
            "properties": {
                "actions": {
                    "type": "array",
                    "title": "List of actions taken on a director relationship",
                    "items": {
                        "type": "string",
                        "enum": [
                            "ADDED",
                            "REMOVED",
                            "NAME_CHANGED",
                            "ADDRESS_CHANGED",
                            "CHANGED"
                        ]
                    }
                }
            }
        }
    },
    "properties": {
        "changeOfDirectors": {
            "type": "object",
            "anyOf": [
                {
                    "required": [
                        "directors"
                    ]
                },
                {
                    "required": [
                        "relationships"
                    ]
                }
            ],
            "properties": {
                "directors": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "allOf": [
                            {
                                "$ref": "https://bcrs.gov.bc.ca/.well_known/schemas/directors#/definitions/director"
                            },
                            {
                                "$ref": "#/definitions/actions"
                            }
                        ]
                    }
                },
                "relationships": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "allOf": [
                            {
                                "$ref": "https://bcrs.gov.bc.ca/.well_known/schemas/relationship"
                            },
                            {
                                "$ref": "#/definitions/relationshipActions"
                            }
                        ]
                    }
                }
            }
        }
    }
}
