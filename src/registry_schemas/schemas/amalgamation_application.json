{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://bcrs.gov.bc.ca/.well_known/schemas/amalgamation_application",
    "type": "object",
    "definitions": {},
    "title": "Amalgamation Application Schema",
    "required": [
        "amalgamationApplication"
    ],
    "properties": {
        "amalgamationApplication": {
            "type": "object",
            "required": [
                "type",
                "amalgamatingBusinesses",
                "nameRequest",
                "parties",
                "contactPoint"
            ],
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "nameRequest": {
                                "properties": {
                                    "legalType": {
                                        "const": "CP"
                                    }
                                },
                                "required": [
                                    "legalType"
                                ]
                            }
                        },
                        "required": [
                            "nameRequest"
                        ]
                    },
                    "then": {
                        "required": [
                            "offices",
                            "cooperative",
                            "resolution"
                        ]
                    },
                    "else": {
                        "required": [
                            "offices",
                            "shareStructure",
                            "courtApproval"
                        ]
                    }
                }
            ],
            "properties": {
                "type": {
                    "type": "string",
                    "title": "The type of Amalgamation",
                    "enum": [
                        "regular",
                        "vertical",
                        "horizontal"
                    ]
                },
                "amalgamatingBusinesses": {
                    "type": "array",
                    "items": {
                        "required": [
                            "role",
                            "identifier"
                        ],
                        "properties": {
                            "role": {
                                "type": "string",
                                "enum": [
                                    "amalgamating",
                                    "holding",
                                    "primary"
                                ]
                            },
                            "identifier": {
                                "type": "string",
                                "minLength": 3,
                                "maxLength": 40,
                                "pattern": "^[0-9a-zA-Z-]+$"
                            },
                            "foreignJurisdiction": {
                                "$ref": "https://bcrs.gov.bc.ca/.well_known/schemas/foreign_jurisdiction"
                            },
                            "legalName": {
                                "type": "string",
                                "pattern": "\\S"
                            }
                        },
                        "dependencies": {
                            "foreignJurisdiction": {
                                "properties": {
                                    "legalName": {
                                        "minLength": 3,
                                        "maxLength": 150
                                    }
                                },
                                "required": ["legalName"]
                            },
                            "legalName": {
                                "required": ["foreignJurisdiction"]
                            }
                        }
                    }
                },
                "nameRequest": {
                    "title": "The resulting business name and type",
                    "$ref": "https://bcrs.gov.bc.ca/.well_known/schemas/name_request"
                },
                "nameTranslations": {
                    "$ref": "https://bcrs.gov.bc.ca/.well_known/schemas/name_translations"
                },
                "contactPoint": {
                    "$ref": "https://bcrs.gov.bc.ca/.well_known/schemas/contactPoint"
                },
                "parties": {
                    "type": "array",
                    "items": {
                        "$ref": "https://bcrs.gov.bc.ca/.well_known/schemas/parties#/definitions/party"
                    }
                },
                "courtOrder": {
                    "$ref": "https://bcrs.gov.bc.ca/.well_known/schemas/court_order#/properties/courtOrder"
                },
                "courtApproval": {
                    "title": "Amalgamation statement",
                    "type": "boolean"
                },
                "cooperative": {
                    "$ref": "https://bcrs.gov.bc.ca/.well_known/schemas/cooperative"
                },
                "resolution": {
                    "type": "string",
                    "maxLength": 1000
                },
                "resolutionDate": {
                    "type": "string",
                    "format": "date"
                },
                "signingDate": {
                    "type": "string",
                    "format": "date"
                },
                "signatory": {
                    "$ref": "https://bcrs.gov.bc.ca/.well_known/schemas/person"
                },
                "offices": {
                    "type": "object",
                    "properties": {
                        "registeredOffice": {
                            "$ref": "https://bcrs.gov.bc.ca/.well_known/schemas/office"
                        },
                        "recordsOffice": {
                            "$ref": "https://bcrs.gov.bc.ca/.well_known/schemas/office"
                        }
                    },
                    "required": [
                        "registeredOffice"
                    ]
                },
                "shareStructure": {
                    "$ref": "https://bcrs.gov.bc.ca/.well_known/schemas/share_structure"
                }
            }
        }
    }
}
