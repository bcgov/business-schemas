{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://bcrs.gov.bc.ca/.well_known/schemas/filing",
  "type": "object",
  "title": "Registry Filing Item",
  "required": ["filing"],
  "properties": {
    "filing": {
      "allOf": [
        {
          "$ref": "https://bcrs.gov.bc.ca/.well_known/schemas/header"
        },
        {
          "$ref": "https://bcrs.gov.bc.ca/.well_known/schemas/business"
        },
        {
          "if": {
            "properties": {
              "business": {
                "properties": {
                  "identifier": {
                    "pattern": "^CP"
                  }
                }
              }
            }
          },
          "then": {
            "allOf": [
              {
                "if": {
                  "properties": {
                    "header": {
                      "properties": {
                        "name": { "const": "annualReport" }
                      }
                    }
                  }
                },
                "then": {
                  "$ref": "https://bcrs.gov.bc.ca/.well_known/schemas/filing_group_combined_ar"
                }
              },
              {
                "if": {
                  "properties": {
                    "header": {
                      "properties": {
                        "name": { "const": "dissolution" }
                      }
                    }
                  }
                },
                "then": {
                  "$ref": "https://bcrs.gov.bc.ca/.well_known/schemas/filing_group_coop_dissolution"
                }
              },
              {
                "if": {
                  "properties": {
                    "header": {
                      "properties": {
                        "name": { "const": "specialResolution" }
                      }
                    }
                  }
                },
                "then": {
                  "$ref": "https://bcrs.gov.bc.ca/.well_known/schemas/filing_group_special_resolution"
                }
              },
              {
                "if": {
                  "properties": {
                    "header": {
                      "properties": {
                        "name": {
                          "not": {
                            "enum": ["annualReport", "specialResolution","dissolution"]
                          }
                        }
                      }
                    }
                  }
                },
                "then": {
                  "$ref": "https://bcrs.gov.bc.ca/.well_known/schemas/filing_group_singular"
                }
              }
            ]
          },
          "else": {
            "$ref": "https://bcrs.gov.bc.ca/.well_known/schemas/filing_group_singular"
          }
        }
      ]
    }
  }
}
