{
  "definitions": {},
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://bcrs.gov.bc.ca/.well_known/schemas/correction",
  "required": [
    "correction"
  ],
  "type": "object",
  "title": "Correction Filing",
  "properties": {
    "correction": {
      "type": "object",
      "required": [
        "correctedFilingId",
        "correctedFilingType",
        "comment"
      ],
      "properties": {
        "correctedFilingId": {
          "type": "integer",
          "title": "The id of the filing being corrected.",
          "examples": [
            2304
          ]
        },
        "correctedFilingType": {
          "type": "string",
          "title": "The type of the main filing being corrected.",
          "enum": [
            "alteration",
            "annualReport",
            "changeOfDirectors",
            "changeOfAddress",
            "continuationIn",
            "conversion",
            "dissolution",
            "specialResolution",
            "changeOfName",
            "incorporationApplication",
            "amalgamationApplication",
            "dissolved",
            "amendedAGM",
            "restoration",
            "amendedAnnualReport",
            "amendedChangeOfDirectors",
            "changeOfReceivers",
            "continuedOut",
            "correction",
            "registration",
            "changeOfRegistration",
            "changeOfLiquidators"
          ]
        },
        "comment": {
          "type": "string",
          "max_length": 4096,
          "pattern": "\\S"
        },
        "commentOnly": {
          "type": "boolean",
          "title": "Flag indicating if only comment was added in the filing"
        },
        "correctedFilingDate": {
          "type": "string",
          "format": "date",
          "title": "The submission date of the final version of the filing being corrected."
        },
        "type": {
          "type": "string",
          "title": "Indicates whether the filing corrects staff error or client error.",
          "enum": [
            "STAFF",
            "CLIENT"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["legalType"],
            "properties": {
              "legalType": {
                "enum": [
                  "SP",
                  "GP"
                ]
              }
            }
          },
          "then": {
            "required": [
              "parties",
              "contactPoint"
            ],
            "properties": {
              "business": {
                "$ref": "https://bcrs.gov.bc.ca/.well_known/schemas/business#/properties/business"
              },
              "nameRequest": {
                "$ref": "https://bcrs.gov.bc.ca/.well_known/schemas/name_request"
              },
              "startDate": {
                "type": "string",
                "format": "date"
              },
              "offices": {
                "type": "object",
                "properties": {
                  "businessOffice": {
                    "$ref": "https://bcrs.gov.bc.ca/.well_known/schemas/office"
                  }
                }
              },
              "parties": {
                "type": "array",
                "items": {
                  "$ref": "https://bcrs.gov.bc.ca/.well_known/schemas/parties#/definitions/party"
                }
              },
              "contactPoint": {
                "$ref": "https://bcrs.gov.bc.ca/.well_known/schemas/contactPoint"
              }
            }
          }
        },
        {
          "if": {
            "required": ["legalType"],
            "properties": {
              "legalType": {
                "enum": [
                  "BC",
                  "BEN",
                  "C",
                  "CBEN",
                  "CC",
                  "CCC",
                  "CUL",
                  "ULC"
                ]
              }
            }
          },
          "then": {
            "required": [
              "contactPoint"
            ],
            "properties": {
              "newLegalType": {
                "$ref": "https://bcrs.gov.bc.ca/.well_known/schemas/business#/definitions/legalType"
              },
              "nameRequest": {
                "$ref": "https://bcrs.gov.bc.ca/.well_known/schemas/name_request"
              },
              "offices": {
                "type": "object",
                "properties": {
                  "registeredOffice": {
                    "$ref": "https://bcrs.gov.bc.ca/.well_known/schemas/office"
                  },
                  "recordsOffice": {
                    "$ref": "https://bcrs.gov.bc.ca/.well_known/schemas/office"
                  }
                },
                "required": [
                  "registeredOffice"
                ]
              },
              "parties": {
                "type": "array",
                "items": {
                  "$ref": "https://bcrs.gov.bc.ca/.well_known/schemas/parties#/definitions/party"
                }
              },
              "contactPoint": {
                "$ref": "https://bcrs.gov.bc.ca/.well_known/schemas/contactPoint"
              },
              "nameTranslations": {
                "$ref": "https://bcrs.gov.bc.ca/.well_known/schemas/name_translations"
              },
              "relationships": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "https://bcrs.gov.bc.ca/.well_known/schemas/relationship"
                }
              },
              "shareStructure": {
                "type": "object",
                "properties": {
                  "resolutionDates": {
                    "oneOf": [
                      {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": ["date"],
                          "properties": {
                            "id": {
                              "type": "integer"
                            },
                            "date": {
                              "type": "string",
                              "format": "date"
                            }
                          }
                        }
                      },
                      {
                        "$ref": "https://bcrs.gov.bc.ca/.well_known/schemas/share_structure#/properties/resolutionDates"
                      }
                    ]
                  },
                  "shareClasses": {
                    "$ref": "https://bcrs.gov.bc.ca/.well_known/schemas/share_structure#/properties/shareClasses"
                  }
                }
              },
              "continuationIn": {
                "type": "object",
                "required": [
                  "country",
                  "identifier",
                  "legalName",
                  "incorporationDate"
                ],
                "properties": {
                  "country": {
                    "$ref": "https://bcrs.gov.bc.ca/.well_known/schemas/foreign_jurisdiction#/properties/country",
                    "title": "The jurisdiction country code."
                  },
                  "region": {
                    "$ref": "https://bcrs.gov.bc.ca/.well_known/schemas/foreign_jurisdiction#/properties/region",
                    "title": "The jurisdiction region code."
                  },
                  "identifier": {
                    "type": "string",
                    "pattern": "\\S",
                    "title": "Identifier of the business in the foreign jurisdiction."
                  },
                  "legalName": {
                    "type": "string",
                    "pattern": "\\S",
                    "title": "Legal name of the business in the foreign jurisdiction."
                  },
                  "incorporationDate": {
                    "type": "string",
                    "format": "date",
                    "title": "Incorporation date of the business in the foreign jurisdiction."
                  },
                  "xpro": {
                    "type": "object",
                    "required": [
                      "identifier"
                    ],
                    "properties": {
                      "identifier": {
                        "$ref": "https://bcrs.gov.bc.ca/.well_known/schemas/business#/definitions/identifier"
                      },
                      "legalName": {
                        "$ref": "https://bcrs.gov.bc.ca/.well_known/schemas/business#/definitions/legalName"
                      }
                    }
                  }
                }
              },
              "continuationOut": {
                "type": "object",
                "required": [
                  "continuationOutDate",
                  "country",
                  "legalName"
                ],
                "properties": {
                  "continuationOutDate": {
                    "type": "string",
                    "format": "date",
                    "title": "Effective date of Continuation Out."
                  },
                  "country": {
                    "$ref": "https://bcrs.gov.bc.ca/.well_known/schemas/foreign_jurisdiction#/properties/country",
                    "title": "The jurisdiction country code."
                  },
                  "region": {
                    "$ref": "https://bcrs.gov.bc.ca/.well_known/schemas/foreign_jurisdiction#/properties/region",
                    "title": "The jurisdiction region code."
                  },
                  "legalName": {
                    "type": "string",
                    "pattern": "\\S",
                    "title": "Legal name of the business in the foreign jurisdiction."
                  }
                }
              },
              "courtOrders": {
                "type": "array",
                "items": {
                  "allOf": [
                    {
                      "$ref": "https://bcrs.gov.bc.ca/.well_known/schemas/court_order#/properties/courtOrder"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "integer",
                          "description": "The unique identifier for the court order."
                        },
                        "filingId": {
                          "type": "integer",
                          "description": "The unique identifier for the filing associated with the court order."
                        }
                      },
                      "required": ["id", "filingId", "fileNumber"]
                    }
                  ]
                }
              },
              "amalgamation": {
                "type": "object",
                "required": [
                  "amalgamatingBusinesses",
                  "courtApproval"
                ],
                "properties": {
                  "amalgamatingBusinesses": {
                    "type": "array",
                    "items": {
                      "required": [
                        "role",
                        "identifier",
                        "foreignJurisdiction",
                        "legalName"
                      ],
                      "properties": {
                        "role": {
                          "type": "string",
                          "enum": [
                            "amalgamating"
                          ]
                        },
                        "identifier": {
                          "type": "string",
                          "minLength": 3,
                          "maxLength": 40,
                          "pattern": "^[0-9a-zA-Z-]+$"
                        },
                        "foreignJurisdiction": {
                          "$ref": "https://bcrs.gov.bc.ca/.well_known/schemas/foreign_jurisdiction"
                        },
                        "legalName": {
                          "type": "string",
                          "pattern": "\\S"
                        }
                      }
                    }
                  },
                  "courtApproval": {
                      "title": "Amalgamation statement",
                      "type": "boolean"
                  }
                }
              },
              "courtOrder": {
                "$ref": "https://bcrs.gov.bc.ca/.well_known/schemas/court_order#/properties/courtOrder"
              }
            }
          }
        },
        {
          "if": {
            "required": ["legalType"],
            "properties": {
              "legalType": {
                "enum": [
                  "CP"
                ]
              }
            }
          },
          "then": {
            "required": [
              "contactPoint",
              "business"
            ],
            "properties": {
              "type": {
                "type": "string"
              },
              "business": {
                "$ref": "https://bcrs.gov.bc.ca/.well_known/schemas/business#/properties/business"
              },
              "contactPoint": {
                "$ref": "https://bcrs.gov.bc.ca/.well_known/schemas/contactPoint"
              },
              "resolution": {
                  "type": "string",
                  "maxLength": 1000
              },
              "resolutionDate": { 
                  "type": "string",
                  "format": "date"
              },
              "signingDate": {
                  "type": "string",
                  "format": "date"
              },
              "signatory": {
                  "$ref": "https://bcrs.gov.bc.ca/.well_known/schemas/person"
              },
              "courtOrder": {
                "$ref": "https://bcrs.gov.bc.ca/.well_known/schemas/court_order#/properties/courtOrder"
              },
              "nameRequest": {
                "$ref": "https://bcrs.gov.bc.ca/.well_known/schemas/name_request"
              },
              "cooperativeAssociationType": {
                "type": "string",
                "title": "The association type for cooperative filing",
                "enum": [
                    "CP",
                    "HC",
                    "CSC"
                ]
              },
              "memorandumInResolution": {
                "type": "boolean",
                "title": "Flag to indicate the memorandum are located in the resolution"
              },
              "rulesInResolution": {
                "type": "boolean",
                "title": "Flag to indicate the rules are located in the resolution"
              },
              "rulesFileKey": {
                "type": "string",
                "title": "The Identifier for rules file in file server"
              }
            }
          }
        }
      ]
    }
  }
}
